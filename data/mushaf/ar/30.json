{"p":{"601":[["103:1","وَالْعَصْرِۙ"],["103:2","اِنَّ الْاِنْسَانَ لَفٖی خُسْرٍۙ"],["103:3","اِلَّا الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ"],["104:1","وَیْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍۙ"],["104:2","اَلَّذٖی جَمَعَ مَالًا وَعَدَّدَهُۙ"],["104:3","یَحْسَبُ اَنَّ مَالَهُٓ اَخْلَدَهُۚ"],["104:4","كَلَّا لَیُنْبَذَنَّ فِی الْحُطَمَةِؗ"],["104:5","وَمَٓا اَدْرٰیكَ مَا الْحُطَمَةُؕ"],["104:6","نَارُ اللّٰهِ الْمُوقَدَةُۙ"],["104:7","اَلَّتٖی تَطَّلِعُ عَلَى الْاَفْــِٔدَةِؕ"],["104:8","اِنَّهَا عَلَیْهِمْ مُؤْصَدَةٌۙ"],["104:9","فٖی عَمَدٍ مُمَدَّدَةٍ"],["105:1","اَلَمْ تَرَ كَیْفَ فَعَلَ رَبُّكَ بِاَصْحَابِ الْفٖیلِؕ"],["105:2","اَلَمْ یَجْعَلْ كَیْدَهُمْ فٖی تَضْلٖیلٍۙ"],["105:3","وَاَرْسَلَ عَلَیْهِمْ طَیْرًا اَبَابٖیلَۙ"],["105:4","تَرْمٖیهِمْ بِحِجَارَةٍ مِنْ سِجّٖیلٍࣕۙ"],["105:5","فَجَعَلَهُمْ كَعَصْفٍ مَاْكُولٍ"]],"602":[["106:1","لِاٖیلَافِ قُرَیْشٍۙ"],["106:2","اٖیلَافِهِمْ رِحْلَةَ الشِّتَٓاءِ وَالصَّیْفِۚ"],["106:3","فَلْیَعْبُدُوا رَبَّ هٰذَا الْبَیْتِۙ"],["106:4","اَلَّذٖٓی اَطْعَمَهُمْ مِنْ جُوعٍ وَاٰمَنَهُمْ مِنْ خَوْفٍ"],["107:1","اَرَاَیْتَ الَّذٖی یُكَذِّبُ بِالدّٖینِؕ"],["107:2","فَذٰلِكَ الَّذٖی یَدُعُّ الْیَتٖیمَۙ"],["107:3","وَلَا یَحُضُّ عَلٰى طَعَامِ الْمِسْكٖینِؕ"],["107:4","فَوَیْلٌ لِلْمُصَلّٖینَۙ"],["107:5","اَلَّذٖینَ هُمْ عَنْ صَلَاتِهِمْ سَاهُونَۙ"],["107:6","اَلَّذٖینَ هُمْ یُرَٓاؤُ࣒نَۙ"],["107:7","وَیَمْنَعُونَ الْمَاعُونَ"],["108:1","اِنَّٓا اَعْطَیْنَاكَ الْكَوْثَرَؕ"],["108:2","فَصَلِّ لِرَبِّكَ وَانْحَرْؕ"],["108:3","اِنَّ شَانِئَكَ هُوَ الْاَبْتَرُ"]],"603":[["109:1","قُلْ یَٓا اَیُّهَا الْكَافِرُونَۙ"],["109:2","لَٓا اَعْبُدُ مَا تَعْبُدُونَۙ"],["109:3","وَلَٓا اَنْتُمْ عَابِدُونَ مَٓا اَعْبُدُۚ"],["109:4","وَلَٓا اَنَا࣑ عَابِدٌ مَا عَبَدْتُمْۙ"],["109:5","وَلَٓا اَنْتُمْ عَابِدُونَ مَٓا اَعْبُدُؕ"],["109:6","لَكُمْ دٖینُكُمْ وَلِیَ دٖینِ"],["110:1","اِذَا جَٓاءَ نَصْرُ اللّٰهِ وَالْفَتْحُۙ"],["110:2","وَرَاَیْتَ النَّاسَ یَدْخُلُونَ فٖی دٖینِ اللّٰهِ اَفْوَاجًاۙ"],["110:3","فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُؕ اِنَّهُ كَانَ تَوَّابًا"],["111:1","تَبَّتْ یَدَٓا اَبٖی لَهَبٍ وَتَبَّؕ"],["111:2","مَٓا اَغْنٰى عَنْهُ مَالُهُ وَمَا كَسَبَؕ"],["111:3","سَیَصْلٰى نَارًا ذَاتَ لَهَبٍۚ"],["111:4","وَامْرَاَتُهُؕ حَمَّالَةَ الْحَطَبِۚ"],["111:5","فٖی جٖیدِهَا حَبْلٌ مِنْ مَسَدٍ"]],"604":[["112:1","قُلْ هُوَ اللّٰهُ اَحَدٌۚ"],["112:2","اَللّٰهُ الصَّمَدُۚ"],["112:3","لَمْ یَلِدْ وَلَمْ یُولَدْۙ"],["112:4","وَلَمْ یَكُنْ لَهُ كُفُوًا اَحَدٌ"],["113:1","قُلْ اَعُوذُ بِرَبِّ الْفَلَقِۙ"],["113:2","مِنْ شَرِّ مَا خَلَقَۙ"],["113:3","وَمِنْ شَرِّ غَاسِقٍ اِذَا وَقَبَۙ"],["113:4","وَمِنْ شَرِّ النَّفَّاثَاتِ فِی الْعُقَدِۙ"],["113:5","وَمِنْ شَرِّ حَاسِدٍ اِذَا حَسَدَ"],["114:1","قُلْ اَعُوذُ بِرَبِّ النَّاسِۙ"],["114:2","مَلِكِ النَّاسِۙ"],["114:3","اِلٰهِ النَّاسِۙ"],["114:4","مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِۙ"],["114:5","اَلَّذٖی یُوَسْوِسُ فٖی صُدُورِ النَّاسِۙ"],["114:6","مِنَ الْجِنَّةِ وَالنَّاسِ"]]}}