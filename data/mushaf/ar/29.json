{"p":{"581":[["78:1","عَمَّ یَتَسَٓاءَلُونَۚ"],["78:2","عَنِ النَّبَاِ الْعَظٖیمِۙ"],["78:3","اَلَّذٖی هُمْ فٖیهِ مُخْتَلِفُونَؕ"],["78:4","كَلَّا سَیَعْلَمُونَۙ"],["78:5","ثُمَّ كَلَّا سَیَعْلَمُونَ"],["78:6","اَلَمْ نَجْعَلِ الْاَرْضَ مِهَادًاۙ"],["78:7","وَالْجِبَالَ اَوْتَادًاࣕ"],["78:8","وَخَلَقْنَاكُمْ اَزْوَاجًاۙ"],["78:9","وَجَعَلْنَا نَوْمَكُمْ سُبَاتًاۙ"],["78:10","وَجَعَلْنَا الَّیْلَ لِبَاسًاۙ"],["78:11","وَجَعَلْنَا النَّهَارَ مَعَاشًاࣕ"],["78:12","وَبَنَیْنَا فَوْقَكُمْ سَبْعًا شِدَادًاۙ"],["78:13","وَجَعَلْنَا سِرَاجًا وَهَّاجًاࣕ"],["78:14","وَاَنْزَلْنَا مِنَ الْمُعْصِرَاتِ مَٓاءً ثَجَّاجًاۙ"],["78:15","لِنُخْرِجَ بِهٖ حَبًّا وَنَبَاتًاۙ"],["78:16","وَجَنَّاتٍ اَلْفَافًاؕ"],["78:17","اِنَّ یَوْمَ الْفَصْلِ كَانَ مٖیقَاتًاۙ"],["78:18","یَوْمَ یُنْفَخُ فِی الصُّورِ فَتَاْتُونَ اَفْوَاجًاۙ"],["78:19","وَفُتِحَتِ السَّمَٓاءُ فَكَانَتْ اَبْوَابًاۙ"],["78:20","وَسُیِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًاؕ"],["78:21","اِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًاۙ"],["78:22","لِلطَّاغٖینَ مَاٰبًاۙ"],["78:23","لَابِثٖینَ فٖیهَٓا اَحْقَابًاۚ"],["78:24","لَا یَذُوقُونَ فٖیهَا بَرْدًا وَلَا شَرَابًاۙ"],["78:25","اِلَّا حَمٖیمًا وَغَسَّاقًاۙ"],["78:26","جَزَٓاءً وِفَاقًا"],["78:27","اِنَّهُمْ كَانُوا لَا یَرْجُونَ حِسَابًاۙ"],["78:28","وَكَذَّبُوا بِاٰیَاتِنَا كِذَّابًاؕ"],["78:29","وَكُلَّ شَیْءٍ اَحْصَیْنَاهُ كِتَابًا"],["78:30","فَذُوقُوا فَلَنْ نَزٖیدَكُمْ اِلَّا عَذَابًاࣖ"]],"582":[["78:31","اِنَّ لِلْمُتَّقٖینَ مَفَازًاۙ"],["78:32","حَدَٓائِقَ وَاَعْنَابًاۙ"],["78:33","وَكَوَاعِبَ اَتْرَابًاۙ"],["78:34","وَكَاْسًا دِهَاقًاؕ"],["78:35","لَا یَسْمَعُونَ فٖیهَا لَغْوًا وَلَا كِذَّابًاۚ"],["78:36","جَزَٓاءً مِنْ رَبِّكَ عَطَٓاءً حِسَابًاۙ"],["78:37","رَبِّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَیْنَهُمَاۙ الرَّحْمٰنِ لَا یَمْلِكُونَ مِنْهُ خِطَابًاۙ"],["78:38","یَوْمَ یَقُومُ الرُّوحُ وَالْمَلٰٓئِكَةُ صَفًّاؕ لَا یَتَكَلَّمُونَ اِلَّا مَنْ اَذِنَ لَهُ الرَّحْمٰنُ وَقَالَ صَوَابًا"],["78:39","ذٰلِكَ الْیَوْمُ الْحَقُّۚ فَمَنْ شَٓاءَ اتَّخَذَ اِلٰى رَبِّهٖ مَاٰبًا"],["78:40","اِنَّ