وَثَمُودَ الَّذٖینَ جَابُوا الصَّخْرَ بِالْوَادِࣕۙ"],["89:10","وَفِرْعَوْنَ ذِی الْاَوْتَادِࣕۙ"],["89:11","اَلَّذٖینَ طَغَوْا فِی الْبِلَادِࣕۙ"],["89:12","فَاَكْثَرُوا فٖیهَا الْفَسَادَࣕۙ"],["89:13","فَصَبَّ عَلَیْهِمْ رَبُّكَ سَوْطَ عَذَابٍࣕۙ"],["89:14","اِنَّ رَبَّكَ لَبِالْمِرْصَادِؕ"]],"593":[["89:15","فَاَمَّا الْاِنْسَانُ اِذَا مَا ابْتَلٰیهُ رَبُّهُ فَاَكْرَمَهُ وَنَعَّمَهُ فَیَقُولُ رَبّٖٓی اَكْرَمَنِؕ"],["89:16","وَاَمَّٓا اِذَا مَا ابْتَلٰیهُ فَقَدَرَ عَلَیْهِ رِزْقَهُ فَیَقُولُ رَبّٖٓی اَهَانَنِۚ"],["89:17","كَلَّا بَلْ لَا تُكْرِمُونَ الْیَتٖیمَۙ"],["89:18","وَلَا تَحَٓاضُّونَ عَلٰى طَعَامِ الْمِسْكٖینِۙ"],["89:19","وَتَاْكُلُونَ التُّرَاثَ اَكْلًا لَمًّاۙ"],["89:20","وَتُحِبُّونَ الْمَالَ حُبًّا جَمًّاؕ"],["89:21","كَلَّٓا اِذَا دُكَّتِ الْاَرْضُ دَكًّا دَكًّاۙ"],["89:22","وَجَٓاءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّاۚ"],["89:23","وَجٖٓیءَ یَوْمَئِذٍ بِجَهَنَّمَ یَوْمَئِذٍ یَتَذَكَّرُ الْاِنْسَانُ وَاَنّٰى لَهُ الذِّكْرٰىؕ"],["89:24","یَقُولُ یَا لَیْتَنٖی قَدَّمْتُ لِحَیَاتٖیۚ"],["89:25","فَیَوْمَئِذٍ لَا یُعَذِّبُ عَذَابَهُٓ اَحَدٌۙ"],["89:26","وَلَا یُوثِقُ وَثَاقَهُٓ اَحَدٌؕ"],["89:27","یَٓا اَیَّتُهَا النَّفْسُ الْمُطْمَئِنَّةُࣗ"],["89:28","اِرْجِعٖٓی اِلٰى رَبِّكِ رَاضِیَةً مَرْضِیَّةًۚ"],["89:29","فَادْخُلٖی فٖی عِبَادٖیۙ"],["89:30","وَادْخُلٖی جَنَّتٖی"],["90:1","لَٓا اُقْسِمُ بِهٰذَا الْبَلَدِۙ"],["90:2","وَاَنْتَ حِلٌّ بِهٰذَا الْبَلَدِۙ"],["90:3","وَوَالِدٍ وَمَا وَلَدَۙ"],["90:4","لَقَدْ خَلَقْنَا الْاِنْسَانَ فٖی كَبَدٍؕ"],["90:5","اَیَحْسَبُ اَنْ لَنْ یَقْدِرَ عَلَیْهِ اَحَدٌۘ"],["90:6","یَقُولُ اَهْلَكْتُ مَالًا لُبَدًاؕ"],["90:7","اَیَحْسَبُ اَنْ لَمْ یَرَهُٓ اَحَدٌؕ"]],"594":[["90:8","اَلَمْ نَجْعَلْ لَهُ عَیْنَیْنِۙ"],["90:9","وَلِسَانًا وَشَفَتَیْنِۙ"],["90:10","وَهَدَیْنَاهُ النَّجْدَیْنِۚ"],["90:11","فَلَا اقْتَحَمَ الْعَقَبَةَؗ"],["90:12","وَمَٓا اَدْرٰیكَ مَا الْعَقَبَةُؕ"],["90:13","فَكُّ رَقَبَةٍۙ"],["90:14","اَوْ اِطْعَامٌ فٖی یَوْمٍ ذٖی مَسْغَبَةٍۙ"],["90:15","یَتٖیمًا ذَا مَقْرَبَةٍۙ"],["90:16","اَوْ مِسْكٖینًا ذَا مَتْرَبَةٍؕ"],["90:17","ثُمَّ كَانَ مِنَ الَّذٖینَ اٰمَنُوا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِؕ"],["90:18","اُو࣑لٰٓئِكَ اَصْحَابُ الْمَیْمَنَةِؕ"],["90:19","وَالَّذٖینَ كَفَرُوا بِاٰیَاتِنَا هُمْ اَصْحَابُ الْمَشْـَٔمَةِؕ"],["90:20","عَلَیْهِمْ نَارٌ مُؤْصَدَةٌ"],["91:1","وَالشَّمْسِ وَضُحٰیهَاࣕۙ"],["91:2","وَالْقَمَرِ اِذَا تَلٰیهَاࣕۙ"],["91:3","وَالنَّهَارِ اِذَا جَلّٰیهَاࣕۙ"],["91:4","وَالَّیْلِ اِذَا یَغْشٰیهَاࣕۙ"],["91:5","وَالسَّمَٓاءِ وَمَا بَنٰیهَاࣕۙ"],["91:6","وَالْاَرْضِ وَمَا طَحٰیهَاࣕۙ"],["91:7","وَنَفْسٍ وَمَا سَوّٰیهَاࣕۙ"],["91:8","فَاَلْهَمَهَا فُجُورَهَا وَتَقْوٰیهَاࣕۙ"],["91:9","قَدْ اَفْلَحَ مَنْ زَكّٰیهَاࣕۙ"],["91:10","وَقَدْ خَابَ مَنْ دَسّٰیهَاؕ"],["91:11","كَذَّبَتْ ثَمُودُ بِطَغْوٰیهَاࣕۙ"],["91:12","اِذِ انْبَعَثَ اَشْقٰیهَاࣕۙ"],["91:13","فَقَالَ لَهُمْ رَسُولُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقْیٰیهَاࣞ"],["91:14","فَكَذَّبُوهُ فَعَقَرُوهَاࣕۙ فَدَمْدَمَ عَلَیْهِمْ رَبُّهُمْ بِذَنْبِهِمْ فَسَوّٰیهَاࣕۙ"],["91:15","وَلَا یَخَافُ عُقْبٰیهَا"]],"595":[["92:1","وَالَّیْلِ اِذَا یَغْشٰىۙ"],["92:2","وَالنَّهَارِ اِذَا تَجَلّٰىۙ"],["92:3","وَمَا خَلَقَ الذَّكَرَ وَالْاُنْثٰىۙ"],["92:4","اِنَّ سَعْیَكُمْ لَشَتّٰىؕ"],["92:5","فَاَمَّا مَنْ اَعْطٰى وَاتَّقٰىۙ"],["92:6","وَصَدَّقَ بِالْحُسْنٰىۙ"],["92:7","فَسَنُیَسِّرُهُ لِلْیُسْرٰىؕ"],["92:8","وَاَمَّا مَنْ بَخِلَ وَاسْتَغْنٰىۙ"],["92:9","وَكَذَّبَ بِالْحُسْنٰىۙ"],["92:10","فَسَنُیَسِّرُهُ لِلْعُسْرٰىؕ"],["92:11","وَمَا یُغْنٖی عَنْهُ مَالُهُٓ اِذَا تَرَدّٰىؕ"],["92:12","اِنَّ عَلَیْنَا لَلْهُدٰىؗ"],["92:13","وَاِنَّ لَنَا لَلْاٰخِرَةَ وَالْاُو࣒لٰى"],["92:14","فَاَنْذَرْتُكُمْ نَارًا تَلَظّٰىۚ"],["92:15","لَا یَصْلٰیهَٓا اِلَّا الْاَشْقٰىۙ"],["92:16","اَلَّذٖی كَذَّبَ وَتَوَلّٰىؕ"],["92:17","وَسَیُجَنَّبُهَا الْاَتْقٰىۙ"],["92:18","اَلَّذٖی یُؤْتٖی مَالَهُ یَتَزَكّٰىۚ"],["92:19","وَمَا لِاَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزٰىۙ"],["92:20","اِلَّا ابْتِغَٓاءَ وَجْهِ رَبِّهِ الْاَعْلٰىۚ"],["92:21","وَلَسَوْفَ یَرْضٰى"],["93:1","وَالضُّحٰىۙ"],["93:2","وَالَّیْلِ اِذَا سَجٰىۙ"],["93:3","مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىؕ"]],"596":[["93:4","وَلَلْاٰخِرَةُ خَیْرٌ لَكَ مِنَ الْاُو࣒لٰىؕ"],["93:5","وَلَسَوْفَ یُعْطٖیكَ رَبُّكَ فَتَرْضٰىؕ"],["93:6","اَلَمْ یَجِدْكَ یَتٖیمًا فَاٰوٰىࣕ"],["93:7","وَوَجَدَكَ ضَٓالًّا فَهَدٰىࣕ"],["93:8","وَوَجَدَكَ عَٓائِلًا فَاَغْنٰىؕ"],["93:9","فَاَمَّا الْیَتٖیمَ فَلَا تَقْهَرْؕ"],["93:10","وَاَمَّا السَّٓائِلَ فَلَا تَنْهَرْؕ"],["93:11","وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"],["94:1","اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ"],["94:2","وَوَضَعْنَا عَنْكَ وِزْرَكَۙ"],["94:3","اَلَّذٖٓی اَنْقَضَ ظَهْرَكَۙ"],["94:4","وَرَفَعْنَا لَكَ ذِكْرَكَؕ"],["94:5","فَاِنَّ مَعَ الْعُسْرِ یُسْرًاۙ"],["94:6","اِنَّ مَعَ الْعُسْرِ یُسْرًاؕ"],["94:7","فَاِذَا فَرَغْتَ فَانْصَبْۙ"],["94:8","وَاِلٰى رَبِّكَ فَارْغَبْ"],["95:1","وَالتّٖینِ وَالزَّیْتُونِۙ"],["95:2","وَطُورِ سٖینٖینَۙ"],["95:3","وَهٰذَا الْبَلَدِ الْاَمٖینِۙ"],["95:4","لَقَدْ خَلَقْنَا الْاِنْسَانَ فٖٓی اَحْسَنِ تَقْوٖیمٍؗ"],["95:5","ثُمَّ رَدَدْنَاهُ اَسْفَلَ سَافِلٖینَۙ"]],"597":[["95:6","اِلَّا الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ اَجْرٌ غَیْرُ مَمْنُونٍؕ"],["95:7","فَمَا یُكَذِّبُكَ بَعْدُ بِالدّٖینِؕ"],["95:8","اَلَیْسَ اللّٰهُ بِاَحْكَمِ الْحَاكِمٖینَ"],["96:1","اِقْرَاْ بِاسْمِ رَبِّكَ الَّذٖی خَلَقَۚ"],["96:2","خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍۚ"],["96:3","اِقْرَاْ وَرَبُّكَ الْاَكْرَمُۙ"],["96:4","اَلَّذٖی عَلَّمَ بِالْقَلَمِۙ"],["96:5","عَلَّمَ الْاِنْسَانَ مَا لَمْ یَعْلَمْؕ"],["96:6","كَلَّٓا اِنَّ الْاِنْسَانَ لَیَطْغٰىۙ"],["96:7","اَنْ رَاٰهُ اسْتَغْنٰىؕ"],["96:8","اِنَّ اِلٰى رَبِّكَ الرُّجْعٰىؕ"],["96:9","اَرَاَیْتَ الَّذٖی یَنْهٰىۙ"],["96:10","عَبْدًا اِذَا صَلّٰىؕ"],["96:11","اَرَاَیْتَ اِنْ كَانَ عَلَى الْهُدٰىۙ"],["96:12","اَوْ اَمَرَ بِالتَّقْوٰىؕ"],["96:13","اَرَاَیْتَ اِنْ كَذَّبَ وَتَوَلّٰىؕ"],["96:14","اَلَمْ یَعْلَمْ بِاَنَّ اللّٰهَ یَرٰىؕ"],["96:15","كَلَّا لَئِنْ لَمْ یَنْتَهِ࣑ لَنَسْفَعًا بِالنَّاصِیَةِۙ"],["96:16","نَاصِیَةٍ كَاذِبَةٍ خَاطِئَةٍۚ"],["96:17","فَلْیَدْعُ نَادِیَهُۙ"],["96:18","سَنَدْعُ الزَّبَانِیَةَۙ"],["96:19","كَلَّاؕ لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ"]],"598":[["97:1","اِنَّٓا اَنْزَلْنَاهُ فٖی لَیْلَةِ الْقَدْرِۚ"],["97:2","وَمَٓا اَدْرٰیكَ مَا لَیْلَةُ الْقَدْرِؕ"],["97:3","لَیْلَةُ الْقَدْرِ خَیْرٌ مِنْ اَلْفِ شَهْرٍؕ"],["97:4","تَنَزَّلُ الْمَلٰٓئِكَةُ وَالرُّوحُ فٖیهَا بِاِذْنِ رَبِّهِمْۚ مِنْ كُلِّ اَمْرٍۙۛ"],["97:5","سَلَامٌࣞۛ هِیَ حَتّٰى مَطْلَعِ الْفَجْرِ"],["98:1","لَمْ یَكُنِ الَّذٖینَ كَفَرُوا مِنْ اَهْلِ الْكِتَابِ وَالْمُشْرِكٖینَ مُنْفَكّٖینَ حَتّٰى تَاْتِیَهُمُ الْبَیِّنَةُۙ"],["98:2","رَسُولٌ مِنَ اللّٰهِ یَتْلُوا صُحُفًا مُطَهَّرَةًۙ"],["98:3","فٖیهَا كُتُبٌ قَیِّمَةٌؕ"],["98:4","وَمَا تَفَرَّقَ الَّذٖینَ اُو࣒تُوا الْكِتَابَ اِلَّا مِنْ بَعْدِ مَا جَٓاءَتْهُمُ الْبَیِّنَةُؕ"],["98:5","وَمَٓا اُمِرُٓوا اِلَّا لِیَعْبُدُوا اللّٰهَ مُخْلِصٖینَ لَهُ الدّٖینَ حُنَفَٓاءَ وَیُقٖیمُوا الصَّلٰوةَ وَیُؤْتُوا الزَّكٰوةَ وَذٰلِكَ دٖینُ الْقَیِّمَةِؕ"],["98:6","اِنَّ الَّذٖینَ كَفَرُوا مِنْ اَهْلِ الْكِتَابِ وَالْمُشْرِكٖینَ فٖی نَارِ جَهَنَّمَ خَالِدٖینَ فٖیهَاؕ اُو࣑لٰٓئِكَ هُمْ شَرُّ الْبَرِیَّةِؕ"],["98:7","اِنَّ الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِۙ اُو࣑لٰٓئِكَ هُمْ خَیْرُ الْبَرِیَّةِؕ"],["98:8","جَزَٓاؤُ࣑هُمْ عِنْدَ رَبِّهِمْ جَنَّاتُ عَدْنٍ تَجْرٖی مِنْ تَحْتِهَا الْاَنْهَارُ خَالِدٖینَ فٖیهَٓا اَبَدًاؕ رَضِیَ اللّٰهُ عَنْهُمْ وَرَضُوا عَنْهُؕ ذٰلِكَ لِمَنْ خَشِیَ رَبَّهُ"]],"599":[["99:1","اِذَا زُلْزِلَتِ الْاَرْضُ زِلْزَالَهَاۙ"],["99:2","وَاَخْرَجَتِ الْاَرْضُ اَثْقَالَهَاۙ"],["99:3","وَقَالَ الْاِنْسَانُ مَا لَهَاۚ"],["99:4","یَوْمَئِذٍ تُحَدِّثُ اَخْبَارَهَاۙ"],["99:5","بِاَنَّ رَبَّكَ اَوْحٰى لَهَاؕ"],["99:6","یَوْمَئِذٍ یَصْدُرُ النَّاسُ اَشْتَاتًا لِیُرَوْا اَعْمَالَهُمْؕ"],["99:7","فَمَنْ یَعْمَلْ مِثْقَالَ ذَرَّةٍ خَیْرًا یَرَهُؕ"],["99:8","وَمَنْ یَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا یَرَهُ"],["100:1","وَالْعَادِیَاتِ ضَبْحًاۙ"],["100:2","فَالْمُورِیَاتِ قَدْحًاۙ"],["100:3","فَالْمُغٖیرَاتِ صُبْحًاۙ"],["100:4","فَاَثَرْنَ بِهٖ نَقْعًاۙ"],["100:5","فَوَسَطْنَ بِهٖ جَمْعًاۙ"],["100:6","اِنَّ الْاِنْسَانَ لِرَبِّهٖ لَكَنُودٌۚ"],["100:7","وَاِنَّهُ عَلٰى ذٰلِكَ لَشَهٖیدٌۚ"],["100:8","وَاِنَّهُ لِحُبِّ الْخَیْرِ لَشَدٖیدٌؕ"],["100:9","اَفَلَا یَعْلَمُ اِذَا بُعْثِرَ مَا فِی الْقُبُورِۙ"],["100:10","وَحُصِّلَ مَا فِی الصُّدُورِۙ"],["100:11","اِنَّ رَبَّهُمْ بِهِمْ یَوْمَئِذٍ لَخَبٖیرٌ"]],"600":[["101:1","اَلْقَارِعَةُۙ"],["101:2","مَا الْقَارِعَةُۚ"],["101:3","وَمَٓا اَدْرٰیكَ مَا الْقَارِعَةُؕ"],["101:4","یَوْمَ یَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِۙ"],["101:5","وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِؕ"],["101:6","فَاَمَّا مَنْ ثَقُلَتْ مَوَازٖینُهُۙ"],["101:7","فَهُوَ فٖی عٖیشَةٍ رَاضِیَةٍؕ"],["101:8","وَاَمَّا مَنْ خَفَّتْ مَوَازٖینُهُۙ"],["101:9","فَاُمُّهُ هَاوِیَةٌؕ"],["101:10","وَمَٓا اَدْرٰیكَ مَا هِیَهْؕ"],["101:11","نَارٌ حَامِیَةٌ"],["102:1","اَلْهٰیكُمُ التَّكَاثُرُۙ"],["102:2","حَتّٰى زُرْتُمُ الْمَقَابِرَؕ"],["102:3","كَلَّا سَوْفَ تَعْلَمُونَۙ"],["102:4","ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَؕ"],["102:5","كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْیَقٖینِؕ"],["102:6","لَتَرَوُنَّ الْجَحٖیمَۙ"],["102:7","ثُمَّ لَتَرَوُنَّهَا عَیْنَ الْیَقٖینِۙ"],["102:8","ثُمَّ لَتُسْـَٔلُنَّ یَوْمَئِذٍ عَنِ النَّعٖیمِ"]]}}