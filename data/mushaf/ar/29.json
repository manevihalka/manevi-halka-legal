سَ عَنِ الْهَوٰىۙ"],["79:41","فَاِنَّ الْجَنَّةَ هِیَ الْمَاْوٰىؕ"],["79:42","یَسْـَٔلُونَكَ عَنِ السَّاعَةِ اَیَّانَ مُرْسٰیهَاؕ"],["79:43","فٖیمَ اَنْتَ مِنْ ذِكْرٰیهَاؕ"],["79:44","اِلٰى رَبِّكَ مُنْتَهٰیهَاؕ"],["79:45","اِنَّمَٓا اَنْتَ مُنْذِرُ مَنْ یَخْشٰیهَاؕ"],["79:46","كَاَنَّهُمْ یَوْمَ یَرَوْنَهَا لَمْ یَلْبَثُٓوا اِلَّا عَشِیَّةً اَوْ ضُحٰیهَا"]],"584":[["80:1","عَبَسَ وَتَوَلّٰىۙ"],["80:2","اَنْ جَٓاءَهُ الْاَعْمٰىؕ"],["80:3","وَمَا یُدْرٖیكَ لَعَلَّهُ یَزَّكّٰىۙ"],["80:4","اَوْ یَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰىؕ"],["80:5","اَمَّا مَنِ اسْتَغْنٰىۙ"],["80:6","فَاَنْتَ لَهُ تَصَدّٰىؕ"],["80:7","وَمَا عَلَیْكَ اَلَّا یَزَّكّٰىؕ"],["80:8","وَاَمَّا مَنْ جَٓاءَكَ یَسْعٰىۙ"],["80:9","وَهُوَ یَخْشٰىۙ"],["80:10","فَاَنْتَ عَنْهُ تَلَهّٰىۚ"],["80:11","كَلَّٓا اِنَّهَا تَذْكِرَةٌۚ"],["80:12","فَمَنْ شَٓاءَ ذَكَرَهُۘ"],["80:13","فٖی صُحُفٍ مُكَرَّمَةٍۙ"],["80:14","مَرْفُوعَةٍ مُطَهَّرَةٍۙ"],["80:15","بِاَیْدٖی سَفَرَةٍۙ"],["80:16","كِرَامٍ بَرَرَةٍؕ"],["80:17","قُتِلَ الْاِنْسَانُ مَٓا اَكْفَرَهُؕ"],["80:18","مِنْ اَیِّ شَیْءٍ خَلَقَهُؕ"],["80:19","مِنْ نُطْفَةٍؕ خَلَقَهُ فَقَدَّرَهُۙ"],["80:20","ثُمَّ السَّبٖیلَ یَسَّرَهُۙ"],["80:21","ثُمَّ اَمَاتَهُ فَاَقْبَرَهُۙ"],["80:22","ثُمَّ اِذَا شَٓاءَ اَنْشَرَهُؕ"],["80:23","كَلَّا لَمَّا یَقْضِ مَٓا اَمَرَهُؕ"],["80:24","فَلْیَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖۙ"],["80:25","اَنَّا صَبَبْنَا الْمَٓاءَ صَبًّاۙ"],["80:26","ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّاۙ"],["80:27","فَاَنْبَتْنَا فٖیهَا حَبًّاۙ"],["80:28","وَعِنَبًا وَقَضْبًاۙ"],["80:29","وَزَیْتُونًا وَنَخْلًاۙ"],["80:30","وَحَدَٓائِقَ غُلْبًاۙ"],["80:31","وَفَاكِهَةً وَاَبًّاۙ"],["80:32","مَتَاعًا لَكُمْ وَلِاَنْعَامِكُمْؕ"],["80:33","فَاِذَا جَٓاءَتِ الصَّٓاخَّةُؗ"]],"585":[["80:34","یَوْمَ یَفِرُّ الْمَرْءُ مِنْ اَخٖیهِۙ"],["80:35","وَاُمِّهٖ وَاَبٖیهِۙ"],["80:36","وَصَاحِبَتِهٖ وَبَنٖیهِؕ"],["80:37","لِكُلِّ امْرِئٍ مِنْهُمْ یَوْمَئِذٍ شَاْنٌ یُغْنٖیهِؕ"],["80:38","وُجُوهٌ یَوْمَئِذٍ مُسْفِرَةٌۙ"],["80:39","ضَاحِكَةٌ مُسْتَبْشِرَةٌۚ"],["80:40","وَوُجُوهٌ یَوْمَئِ