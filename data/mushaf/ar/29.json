اَبْرَارَ لَفٖی نَعٖیمٍۚ"],["82:14","وَاِنَّ الْفُجَّارَ لَفٖی جَحٖیمٍۚ"],["82:15","یَصْلَوْنَهَا یَوْمَ الدّٖینِ"],["82:16","وَمَا هُمْ عَنْهَا بِغَٓائِبٖینَؕ"],["82:17","وَمَٓا اَدْرٰیكَ مَا یَوْمُ الدّٖینِۙ"],["82:18","ثُمَّ مَٓا اَدْرٰیكَ مَا یَوْمُ الدّٖینِؕ"],["82:19","یَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَیْـًٔاؕ وَالْاَمْرُ یَوْمَئِذٍ لِلّٰهِ"]],"587":[["83:1","وَیْلٌ لِلْمُطَفِّفٖینَۙ"],["83:2","اَلَّذٖینَ اِذَا ا‌كْتَالُوا عَلَى النَّاسِ یَسْتَوْفُونَؗ"],["83:3","وَاِذَا كَالُوهُمْ اَوْ وَزَنُوهُمْ یُخْسِرُونَؕ"],["83:4","اَلَا یَظُنُّ اُو࣑لٰٓئِكَ اَنَّهُمْ مَبْعُوثُونَۙ"],["83:5","لِیَوْمٍ عَظٖیمٍۙ"],["83:6","یَوْمَ یَقُومُ النَّاسُ لِرَبِّ الْعَالَمٖینَۚ"],["83:7","كَلَّٓا اِنَّ كِتَابَ الْفُجَّارِ لَفٖی سِجّٖینٍؕ"],["83:8","وَمَٓا اَدْرٰیكَ مَا سِجّٖینٌؕ"],["83:9","كِتَابٌ مَرْقُومٌؕ"],["83:10","وَیْلٌ یَوْمَئِذٍ لِلْمُكَذِّبٖینَۙ"],["83:11","اَلَّذٖینَ یُكَذِّبُونَ بِیَوْمِ الدّٖینِؕ"],["83:12","وَمَا یُكَذِّبُ بِهٖٓ اِلَّا كُلُّ مُعْتَدٍ اَثٖیمٍۙ"],["83:13","اِذَا تُتْلٰى عَلَیْهِ اٰیَاتُنَا قَالَ اَسَاطٖیرُ الْاَوَّلٖینَؕ"],["83:14","كَلَّا بَلْۜ رَانَ عَلٰى قُلُوبِهِمْ مَا كَانُوا یَكْسِبُونَ"],["83:15","كَلَّٓا اِنَّهُمْ عَنْ رَبِّهِمْ یَوْمَئِذٍ لَمَحْجُوبُونَؕ"],["83:16","ثُمَّ اِنَّهُمْ لَصَالُوا الْجَحٖیمِؕ"],["83:17","ثُمَّ یُقَالُ هٰذَا الَّذٖی كُنْتُمْ بِهٖ تُكَذِّبُونَؕ"],["83:18","كَلَّٓا اِنَّ كِتَابَ الْاَبْرَارِ لَفٖی عِلِّیّٖینَؕ"],["83:19","وَمَٓا اَدْرٰیكَ مَا عِلِّیُّونَؕ"],["83:20","كِتَابٌ مَرْقُومٌۙ"],["83:21","یَشْهَدُهُ الْمُقَرَّبُونَؕ"],["83:22","اِنَّ الْاَبْرَارَ لَفٖی نَعٖیمٍۙ"],["83:23","عَلَى الْاَرَٓائِكِ یَنْظُرُونَۙ"],["83:24","تَعْرِفُ فٖی وُجُوهِهِمْ نَضْرَةَ النَّعٖیمِۚ"],["83:25","یُسْقَوْنَ مِنْ رَحٖیقٍ مَخْتُومٍۙ"],["83:26","خِتَامُهُ مِسْكٌؕ وَفٖی ذٰلِكَ فَلْیَتَنَافَسِ الْمُتَنَافِسُونَؕ"]],"588":[["83:27","وَمِزَاجُهُ مِنْ تَسْنٖیمٍۙ"],["83:28","عَیْنًا یَشْرَبُ بِهَا الْمُقَرَّبُونَؕ"],["83:29","اِنَّ الَّذٖینَ اَجْرَمُوا كَانُوا مِنَ الَّذٖینَ اٰمَنُوا یَضْحَكُونَؗ"],["83:30","وَاِذَا مَرُّوا بِهِمْ یَتَغَامَزُونَؗ"],["83:31","وَاِذَا انْقَلَبُٓوا اِلٰٓى اَهْلِهِمُ انْقَلَبُوا فَكِهٖینَؗ"],["83:32","وَاِذَا رَاَوْهُمْ قَالُٓوا اِنَّ هٰٓؤُ࣑لَٓاءِ لَضَٓالُّونَۙ"],["83:33","وَمَٓا اُرْسِلُوا عَلَیْهِمْ حَافِظٖینَؕ"],["83:34","فَالْیَوْمَ الَّذٖینَ اٰمَنُوا مِنَ الْكُفَّارِ یَضْحَكُونَۙ"],["83:35","عَلَى الْاَرَٓائِكِۙ یَنْظُرُونَؕ"],["83:36","هَلْ ثُوِّبَ الْكُفَّارُ مَا كَانُوا یَفْعَلُونَ"],["84:1","اِذَا السَّمَٓاءُ انْشَقَّتْۙ"],["84:2","وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْۙ"],["84:3","وَاِذَا الْاَرْضُ مُدَّتْۙ"],["84:4","وَاَلْقَتْ مَا فٖیهَا وَتَخَلَّتْۙ"],["84:5","وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْؕ"],["84:6","یَٓا اَیُّهَا الْاِنْسَانُ اِنَّكَ كَادِحٌ اِلٰى رَبِّكَ كَدْحًا فَمُلَاقٖیهِۚ"],["84:7","فَاَمَّا مَنْ اُو࣒تِیَ كِتَابَهُ بِیَمٖینِهٖۙ"],["84:8","فَسَوْفَ یُحَاسَبُ حِسَابًا یَسٖیرًاۙ"],["84:9","وَیَنْقَلِبُ اِلٰٓى اَهْلِهٖ مَسْرُورًاؕ"],["84:10","وَاَمَّا مَنْ اُو࣒تِیَ كِتَابَهُ وَرَٓاءَ ظَهْرِهٖۙ"],["84:11","فَسَوْفَ یَدْعُوا ثُبُورًاۙ"],["84:12","وَیَصْلٰى سَعٖیرًاؕ"],["84:13","اِنَّهُ كَانَ فٖٓی اَهْلِهٖ مَسْرُورًا"]],"589":[["84:14","اِنَّهُ ظَنَّ اَنْ لَنْ یَحُورَۚۛ"],["84:15","بَلٰىۚۛ اِنَّ رَبَّهُ كَانَ بِهٖ بَصٖیرًاؕ"],["84:16","فَلَٓا اُقْسِمُ بِالشَّفَقِۙ"],["84:17","وَالَّیْلِ وَمَا وَسَقَۙ"],["84:18","وَالْقَمَرِ اِذَا اتَّسَقَۙ"],["84:19","لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍؕ"],["84:20","فَمَا لَهُمْ لَا یُؤْمِنُونَۙ"],["84:21","وَاِذَا قُرِئَ عَلَیْهِمُ الْقُرْاٰنُ لَا یَسْجُدُونَؕ"],["84:22","بَلِ الَّذٖینَ كَفَرُوا یُكَذِّبُونَؗ"],["84:23","وَاللّٰهُ اَعْلَمُ بِمَا یُوعُونَؗ"],["84:24","فَبَشِّرْهُمْ بِعَذَابٍ اَلٖیمٍۙ"],["84:25","اِلَّا الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ اَجْرٌ غَیْرُ مَمْنُونٍ"],["85:1","وَالسَّمَٓاءِ ذَاتِ الْبُرُوجِۙ"],["85:2","وَالْیَوْمِ الْمَوْعُودِۙ"],["85:3","وَشَاهِدٍ وَمَشْهُودٍؕ"],["85:4","قُتِلَ اَصْحَابُ الْاُخْدُودِۙ"],["85:5","اَلنَّارِ ذَاتِ الْوَقُودِۙ"],["85:6","اِذْ هُمْ عَلَیْهَا قُعُودٌۙ"],["85:7","وَهُمْ عَلٰى مَا یَفْعَلُونَ بِالْمُؤْمِنٖینَ شُهُودٌؕ"],["85:8","وَمَا نَقَمُوا مِنْهُمْ اِلَّٓا اَنْ یُؤْمِنُوا بِاللّٰهِ الْعَزٖیزِ الْحَمٖیدِۙ"],["85:9","اَلَّذٖی لَهُ مُلْكُ السَّمٰوَاتِ وَالْاَرْضِؕ وَاللّٰهُ عَلٰى كُلِّ شَیْءٍ شَهٖیدٌؕ"],["85:10","اِنَّ الَّذٖینَ فَتَنُوا الْمُؤْمِنٖینَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ یَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرٖیقِؕ"],["85:11","اِنَّ الَّذٖینَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ جَنَّاتٌ تَجْرٖی مِنْ تَحْتِهَا الْاَنْهَارُؕ ذٰلِكَ الْفَوْزُ الْكَبٖیرُؕ"]],"590":[["85:12","اِنَّ بَطْشَ رَبِّكَ لَشَدٖیدٌؕ"],["85:13","اِنَّهُ هُوَ یُبْدِئُ وَیُعٖیدُۚ"],["85:14","وَهُوَ الْغَفُورُ الْوَدُودُۙ"],["85:15","ذُوالْعَرْشِ الْمَجٖیدُۙ"],["85:16","فَعَّالٌ لِمَا یُرٖیدُؕ"],["85:17","هَلْ اَتٰیكَ حَدٖیثُ الْجُنُودِۙ"],["85:18","فِرْعَوْنَ وَثَمُودَؕ"],["85:19","بَلِ الَّذٖینَ كَفَرُوا فٖی تَكْذٖیبٍۙ"],["85:20","وَاللّٰهُ مِنْ وَرَٓائِهِمْ مُحٖیطٌۚ"],["85:21","بَلْ هُوَ قُرْاٰنٌ مَجٖیدٌۙ"],["85:22","فٖی لَوْحٍ مَحْفُوظٍ"],["86:1","وَالسَّمَٓاءِ وَالطَّارِقِۙ"],["86:2","وَمَٓا اَدْرٰیكَ مَا الطَّارِقُۙ"],["86:3","اَلنَّجْمُ الثَّاقِبُۙ"],["86:4","اِنْ كُلُّ نَفْسٍ لَمَّا عَلَیْهَا حَافِظٌؕ"],["86:5","فَلْیَنْظُرِ الْاِنْسَانُ مِمَّ خُلِقَؕ"],["86:6","خُلِقَ مِنْ مَٓاءٍ دَافِقٍۙ"],["86:7","یَخْرُجُ مِنْ بَیْنِ الصُّلْبِ وَالتَّرَٓائِبِؕ"],["86:8","اِنَّهُ عَلٰى رَجْعِهٖ لَقَادِرٌؕ"],["86:9","یَوْمَ تُبْلَى السَّرَٓائِرُۙ"],["86:10","فَمَا لَهُ مِنْ قُوَّةٍ وَلَا نَاصِرٍؕ"],["86:11","وَالسَّمَٓاءِ ذَاتِ الرَّجْعِۙ"],["86:12","وَالْاَرْضِ ذَاتِ الصَّدْعِۙ"],["86:13","اِنَّهُ لَقَوْلٌ فَصْلٌۙ"],["86:14","وَمَا هُوَ بِالْهَزْلِؕ"],["86:15","اِنَّهُمْ یَكٖیدُونَ كَیْدًاۙ"],["86:16","وَاَ‌كٖیدُ كَیْدًاۚ"],["86:17","فَمَهِّلِ الْكَافِرٖینَ اَمْهِلْهُمْ رُوَیْدًا"]],"591":[["87:1","سَبِّحِ اسْمَ رَبِّكَ الْاَعْلٰىۙ"],["87:2","اَلَّذٖی خَلَقَ فَسَوّٰىࣕۙ"],["87:3","وَالَّذٖی قَدَّرَ فَهَدٰىࣕۙ"],["87:4","وَالَّذٖٓی اَخْرَجَ الْمَرْعٰىࣕۙ"],["87:5","فَجَعَلَهُ غُثَٓاءً اَحْوٰىؕ"],["87:6","سَنُقْرِئُكَ فَلَا تَنْسٰىۙ"],["87:7","اِلَّا مَا شَٓاءَ اللّٰهُؕ اِنَّهُ یَعْلَمُ الْجَهْرَ وَمَا یَخْفٰىؕ"],["87:8","وَنُیَسِّ